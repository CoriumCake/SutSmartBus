# Server Configuration
# Copy this file to .env and edit with your settings

# ===========================================
# MQTT Broker Settings
# ===========================================
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ===========================================
# MongoDB Settings
# ===========================================
MONGODB_URL=mongodb://localhost:27017/sut_smart_bus

# ===========================================
# Timezone
# ===========================================
TZ=Asia/Bangkok

# ===========================================
# Security Settings
# ===========================================

# API Authentication Key (REQUIRED for production)
# Generate a new key with: python -c "import secrets; print(secrets.token_hex(32))"
# Example: 94dc28a9d3917361f6f2e39851136873c2937559587418936777bf59e07d7228
API_SECRET_KEY=

# Admin password for protected admin flows
ADMIN_PASSWORD=admin123

# CORS Allowed Origins (comma-separated, or "*" for all)
# For production, restrict to your app domains
CORS_ORIGINS=*

# Rate limiting (requests per minute, per IP)
RATE_LIMIT_PER_MINUTE=60

# Maximum firmware upload size in bytes (default: 2MB)
MAX_UPLOAD_SIZE=2097152

# OTA fallback IP for devices that cannot resolve the primary host
OTA_FALLBACK_IP=203.158.3.14

# Public HTTPS base URL for OTA downloads when devices update over the internet
# Example: https://api.your-domain.com
OTA_PUBLIC_BASE_URL=

# Local SQLite file for passenger history
DB_FILE=bus_passengers.db
